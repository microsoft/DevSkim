[
    {
        "name": "HTML link missing noopener or noreferrer",
        "id": "DS610000",
        "description": "An anchor with target=\"_blank\" gives the opened page a window.opener reference back to this one. The opened page can use it to navigate this tab to a site of its choosing, which is the reverse tabnabbing phishing technique.",
        "recommendation": "Add rel=\"noopener noreferrer\" to the anchor.",
        "applies_to": [
            "html",
            "javascript",
            "javascriptreact",
            "typescript",
            "typescriptreact",
            "php"
        ],
        "tags": [
            "Web.HTML"
        ],
        "confidence": "medium",
        "severity": "BestPractice",
        "rule_info": "DS610000.md",
        "patterns": [
            {
                "pattern": "<a(?=\\s)(?:[^\"'>]|\"[^\"]*\"|'[^']*')*>",
                "type": "regex",
                "scopes": [
                    "code"
                ],
                "modifiers": [
                    "i"
                ]
            }
        ],
        "conditions": [
            {
                "pattern": {
                    "pattern": "^<a(?=\\s)(?:[^\"'>]|\"[^\"]*\"|'[^']*')*?\\s+target\\s*=\\s*(?:\"_blank\"|'_blank'|_blank(?=[\\s>]))",
                    "type": "regex",
                    "scopes": [
                        "code"
                    ],
                    "modifiers": [
                        "i"
                    ]
                },
                "negate_finding": false,
                "search_in": "finding-only"
            },
            {
                "pattern": {
                    "pattern": "^<a(?=\\s)(?:[^\"'>]|\"[^\"]*\"|'[^']*')*?\\s+rel\\s*=\\s*(?:\"\\s*(?:[^\"\\s]+\\s+)*(?:noopener|noreferrer)(?=\\s|\")[^\"]*\"|'\\s*(?:[^'\\s]+\\s+)*(?:noopener|noreferrer)(?=\\s|')[^']*'|(?:noopener|noreferrer)(?=[\\s>]))",
                    "type": "regex",
                    "scopes": [
                        "code"
                    ],
                    "modifiers": [
                        "i"
                    ]
                },
                "negate_finding": true,
                "search_in": "finding-only"
            }
        ],
        "must-match": [
            "<a href=\"https://example.com\" target=\"_blank\">Open</a><a rel=\"noopener\" href=\"/about\">About</a>",
            "<a href=\"https://example.com\" target=\"_blank\">Open</a>"
        ],
        "must-not-match": [
            "<a href=\"https://example.com\"\n   target=\"_blank\"\n   rel=\"noopener noreferrer\">Open</a>",
            "<a href=\"https://example.com\" target=\"_blank\" rel=\"noopener noreferrer\">Open</a>",
            "<a href=\"/about\">About</a>"
        ]
    }
]
